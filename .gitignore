.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/

# reportes generados al ejecutar (se conservan solo las carpetas)
reports/*
!reports/.gitkeep

# editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db

